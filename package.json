{
  "name": "pokemon-card-price-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "대전쟁통계검사": "npx tsx scripts/check-battle-stats.mts",
    "dev": "vite",
    "build": "node scripts/check-deploy-files.mjs && tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "대조표": "tsx scripts/card-id-map/build.mts",
    "대조표검사": "tsx scripts/card-id-map/check.mts",
    "소스점검": "npx tsx scripts/check-sources.mts",
    "프린팅전환검증": "npx tsx scripts/check-printings-switch.mts",
    "뽑기검증": "npx tsx scripts/check-pack-rates.mts",
    "이베이긁기검사": "npx tsx scripts/check-ebay-scan.mts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "pureimage": "^0.4.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
