// 대전쟁 통계 셈 검사. **로그인 없이 돈다.**
//
// ⚠️ 왜 필요한가: 통계 화면은 운영자로 로그인해야 서버가 자료를 준다. 로컬에서는 못 열어
//    보므로 셈이 맞는지 눈으로 확인할 방법이 없었다 — 그래서 셈만 떼어 여기서 검사한다.
//
// 사용법: npx tsx scripts/check-battle-stats.mts

import { 까닭머리, 까닭모으기, 난이도별모으기, 옛기록칸, 전투줄읽기, 판별모으기 } from '../src/lib/battleStats.ts'

let 어긋남 = 0
function 같나(무엇: string, 받은: unknown, 바란: unknown) {
  const a = JSON.stringify(받은)
  const b = JSON.stringify(바란)
  if (a === b) { console.log(`  ✓ ${무엇}`); return }
  어긋남++
  console.log(`  ✗ ${무엇}\n      받음: ${a}\n      바람: ${b}`)
}

console.log('줄 뜯기')
같나('새 꼴(세 칸)', 전투줄읽기('1. 1번도로 · 어려움 · 깸'), { 판: '1. 1번도로', 난: '어려움', 무엇: '깸' })
같나('옛 꼴(두 칸)', 전투줄읽기('1. 1번도로 · 깸'), { 판: '1. 1번도로', 난: null, 무엇: '깸' })
// ⚠️ 스테이지 이름에 「 · 」가 들어가는 날이 오면 앞에서 세는 방식은 조용히 밀린다.
같나('판 이름에 가운뎃점이 들어도', 전투줄읽기('7. 탑 · 지하 · 보통 · 짐'),
  { 판: '7. 탑 · 지하', 난: '보통', 무엇: '짐' })
같나('한 칸짜리는 버린다', 전투줄읽기('이상한줄'), null)
// ⚠️ 왜 졌나 줄은 **같은 표에 같이 산다** — 판별·난이도별 셈이 이걸 집으면 유령 줄이 생긴다.
같나('왜 졌나 줄은 판·난이도 셈에서 빠진다', 전투줄읽기(`${까닭머리}벽없음`), null)

const 줄들 = [
  { name: '1. 1번도로 · 쉬움 · 시작', count: 10 },
  { name: '1. 1번도로 · 쉬움 · 깸', count: 9 },
  { name: '1. 1번도로 · 어려움 · 시작', count: 8 },
  { name: '1. 1번도로 · 어려움 · 깸', count: 1 },
  { name: '1. 1번도로 · 어려움 · 짐', count: 7 },
  { name: '2. 상록숲 · 보통 · 시작', count: 5 },
  { name: '2. 상록숲 · 보통 · 깸', count: 3 },
  // 난이도를 넣기 전에 쌓인 것 — **버리면 안 된다**
  { name: '3. 회색시티 체육관 · 시작', count: 4 },
  { name: '3. 회색시티 체육관 · 깸', count: 2 },
  // 왜 졌나 — **같은 표에 섞여 온다**(서버가 한 표에 쌓는다).
  { name: `${까닭머리}벽없음`, count: 5 },
  { name: `${까닭머리}상성`, count: 2 },
  { name: `${까닭머리}처음보는까닭`, count: 1 },
  // 시작해 놓고 나간 것 — **깸도 짐도 아닌 셋째 갈래다**
  { name: '1. 1번도로 · 쉬움 · 그만둠', count: 4 },
  { name: '3. 회색시티 체육관 · 그만둠', count: 2 },
  // 모르는 말은 **아무 칸에도 안 들어가야** 한다
  { name: '1. 1번도로 · 쉬움 · 처음보는말', count: 99 },
]

console.log('\n판별 모으기')
같나('판마다 시작·깸·짐이 합쳐지고 판 번호대로 선다', 판별모으기(줄들), [
  { 판: '1. 1번도로', 시작: 18, 깸: 10, 짐: 7, 그만둠: 4 },
  { 판: '2. 상록숲', 시작: 5, 깸: 3, 짐: 0, 그만둠: 0 },
  { 판: '3. 회색시티 체육관', 시작: 4, 깸: 2, 짐: 0, 그만둠: 2 },
])

console.log('\n난이도별 모으기')
같나('쉬움·보통·어려움 차례로 서고 옛 기록은 따로 남는다', 난이도별모으기(줄들), [
  { 난: '쉬움', 시작: 10, 깸: 9, 짐: 0, 그만둠: 4 },
  { 난: '보통', 시작: 5, 깸: 3, 짐: 0, 그만둠: 0 },
  { 난: '어려움', 시작: 8, 깸: 1, 짐: 7, 그만둠: 0 },
  { 난: 옛기록칸, 시작: 4, 깸: 2, 짐: 0, 그만둠: 2 },
])

console.log('\n왜 졌나 모으기')
같나('많은 것부터 서고, 모르는 열쇠는 그대로 남는다', 까닭모으기(줄들), [
  { 까닭: '벽을 안 냈다', 수: 5 },
  { 까닭: '상성이 밀렸다', 수: 2 },
  { 까닭: '처음보는까닭', 수: 1 },
])
같나('까닭 줄이 없으면 빈 표', 까닭모으기([{ name: '1. 1번도로 · 쉬움 · 깸', count: 3 }]), [])

// ⚠️⚠️ **잃은 것이 없나**를 따로 센다. 위 두 표는 같은 줄을 다르게 모은 것이므로 합이 같아야 한다.
const 합 = (xs: { 시작: number; 깸: number; 짐: number; 그만둠: number }[]) =>
  xs.reduce((a, b) => ({ 시작: a.시작 + b.시작, 깸: a.깸 + b.깸, 짐: a.짐 + b.짐, 그만둠: a.그만둠 + b.그만둠 }),
    { 시작: 0, 깸: 0, 짐: 0, 그만둠: 0 })
console.log('\n두 표의 합이 같나 (한쪽에서만 새면 여기서 잡힌다)')
같나('판별 합 = 난이도별 합', 합(판별모으기(줄들)), 합(난이도별모으기(줄들)))
같나('원본 합과도 같다 · 모르는 말 99는 어디에도 안 샌다', 합(판별모으기(줄들)), { 시작: 27, 깸: 15, 짐: 7, 그만둠: 6 })

console.log(어긋남 ? `\n${어긋남}가지 어긋납니다.` : '\n전부 맞습니다.')
process.exit(어긋남 ? 1 : 0)
