// 포켓몬 대전쟁 난이도를 **실제로 돌려 본다.** 화면 없이 규칙만 굴린다.
//
// ⚠️⚠️ 왜: 앞판에서 표만 보고 「되겠지」 하고 냈다가 **40판 중 0판 클리어**였다.
//    보스 배수를 26 → 12 → 7 → 4.5까지 네 번 고쳤다. **표는 답을 안 준다 — 돌려 봐야 안다.**
//
// ⚠️⚠️⚠️ 잣대는 「이기나 지나」가 아니라 **「어떻게 하면 이기나」**다.
//    ① 벽만 세우면 진다 — 벽으로는 성을 못 부순다
//    ② 비싼 것만 내면 진다 — 모으는 동안 뚫린다
//    ③ 아무거나 막 누르면 **앞은 이기고 뒤는 진다** — 그래야 배울 게 생긴다
//    ④ 낼 수 있는 걸 다 내면(보통 사람) 대체로 이긴다
//    ⑤ **상성을 맞추면 끝까지 간다** — 이게 포켓몬 게임인 까닭이다
//    ⚠️ ③④가 12스테이지 내내 다 이기면 **생각할 거리가 없는 것**이고, ⑤가 못 이기면
//       **손쓸 방법이 없는 것**이다. 둘 다 고장이다.
//
// 사용법: npx tsx scripts/sim-poke-defense.mts

import {
  내보내기, 난이도들, 난이도표, 도감맵, 상성배수, 새판, 판덱, 판목록, 한프레임,
  type 난이도, type 스테이지, type 유닛, type 판,
} from '../src/lib/pokeDefense.ts'

// ⚠️ 화면은 1/60로 도는데 여기서는 1/30으로 굴린다. 1,000판을 넘게 돌려야 해서다.
//    두 값으로 표본을 맞대 봤을 때 승패가 갈린 판은 없었다.
const DT = 1 / 30
const 최대초 = 300

// ⚠️ 판마다 **쓸 수 있는 여덟이 고정**이라(시즌1) 작전끼리 같은 덱을 쓴다.
//    앞서 있던 「덱을 잘 짠 사람 vs 안 바꾼 사람」 비교는 걷어냈다 — 고를 게 없어졌다.

type 작전 = (돈: number, s: 스테이지, r: () => number, 쓸것: 유닛[], p: 판) => 유닛[]

const 작전들: Record<string, 작전> = {
  // ⚠️ 같은 까닭으로 **제일 싼 것**을 값으로 고른다(덱 첫 칸이 늘 벽인 것은 아니다).
  벽만: (_돈, _s, _r, 쓸것) => [[...쓸것].sort((a, b) => a.값 - b.값)[0]],
  // ⚠️ **값으로 골라야 한다.** 처음에 `[쓸것[7], 쓸것[6]]`(덱 자리 순)로 뽑았는데,
  //    덱은 값 순이 아니라서 엉뚱한 둘을 재고 있었다 — 조정 스크립트와 답이 갈려 헤맸다.
  비싼것만: (_돈, _s, _r, 쓸것) => [...쓸것].sort((a, b) => b.값 - a.값).slice(0, 2),
  막누름: (_돈, _s, r, 쓸것) => [쓸것[Math.floor(r() * 쓸것.length)]],
  // ⚠️ 보통 사람 = 낼 수 있는 것을 **싼 것부터** 다 낸다. 사람이 실제로 하는 짓이다.
  다내기: (_돈, _s, _r, 쓸것) => 쓸것,
  // ⚠️ **싼 것 넷만.** 판이 준 여덟 중 비싼 쪽을 안 쓰면 어떻게 되나 — 값이 뜻이 있으려면
  //    이 작전이 「다내기」보다 확실히 못해야 한다.
  싼것만: (_돈, _s, _r, 쓸것) => [...쓸것].sort((a, b) => a.값 - b.값).slice(0, 4),
  /**
   * ⚠️⚠️⚠️ **별을 재는 자다 — 「잘하는 사람」의 기준이다.**
   * 둘을 한다: ①**쉬는 참에는 아예 안 낸다**(적이 판에 없으면 돈만 버린다)
   *           ②값 대비 딜(상성 포함)이 좋은 것만 낸다.
   * ⚠️ ①이 알맹이다. 파상공세로 바꾼 까닭이 이것이고, 이걸 빼면 「다 내기」와 차이가 안 난다
   *    (실측: ①을 넣으면 40~53%, 빼면 52~75%).
   */
  아껴서: (_돈, s, _r, 쓸것, p) => {
    if (!p.놈들.some((n) => !n.우리편 && n.hp > 0)) return []
    const 적타입 = s.적.map((n) => 도감맵.get(n.id)!.타입)
    const 점 = (u: 유닛) => 적타입.reduce((a, t) => a + 상성배수(u.타입, t), 0) / 적타입.length
    const 벽 = [...쓸것].sort((a, b) => a.값 - b.값)[0]
    const 좋 = [...쓸것].filter((u) => u !== 벽)
      .sort((a, b) => (점(b) * b.공) / b.간격 / b.값 - (점(a) * a.공) / a.간격 / a.값).slice(0, 3)
    return [벽, ...좋]
  },
}

function 한판(s: 스테이지, f: 작전, 씨: number, 쓸것: 유닛[]): { 이김: boolean; 초: number; 남은적성: number } {
  let x = 씨 || 1
  const r = () => { x = (x * 1103515245 + 12345) & 0x7fffffff; return x / 0x7fffffff }
  const p = 새판(s)
  let t = 0
  let 다음누름 = 0
  while (!p.끝 && t < 최대초) {
    if (t >= 다음누름) { for (const u of f(p.돈, s, r, 쓸것, p)) 내보내기(p, u); 다음누름 = t + 0.25 }
    한프레임(p, s, DT)
    t += DT
  }
  return { 이김: p.끝 === '승', 초: t, 쓴돈: p.쓴돈 }
}

const 이름들 = Object.keys(작전들)
const 판수 = 6

/**
 * ⚠️⚠️⚠️ **별은 이제 난이도가 준다**(쉬움 ★ · 보통 ★★ · 어려움 ★★★).
 *    앞서 「쓴 돈」으로 매기던 것을 걷어냈다(사장님 2026-08-17). 그래서 이 검사기가 보는 것도
 *    「별이 갈리나」가 아니라 **「난이도 셋이 제대로 갈리나」**다.
 *
 * 잣대:
 *   ① 벽만 세우면 **셋 다** 진다
 *   ② 「아껴서 내기」(잘하는 사람)는 **셋 다 12판을 깬다** — 어려움도 손쓸 방법이 있어야 한다
 *   ③ 「다 내기」는 **어려움에서 몇 판 놓친다** — 안 그러면 어려움이 어렵지 않다
 *   ④ 난이도가 올라갈수록 「막 눌러 대기」가 확실히 못 깨야 한다
 */
const 표: Record<난이도, Record<string, number>> = { 쉬움: {}, 보통: {}, 어려움: {} }
/**
 * ⚠️⚠️ **「깰 수 있나」는 판마다 봐야 한다.** 합계끼리 `max`를 취하면 틀린다 —
 *    어려움에서 3·8번은 「다 내기」로 못 깨고 7·9번은 「아껴서」로 못 깨는데,
 *    합계는 둘 다 10/12라 「2판이 불가능하다」고 잘못 신고했다(2026-08-17).
 *    실제로는 판마다 한쪽이 깨므로 **12판 다 깰 수 있다.**
 */
const 깰수있나: Record<난이도, number> = { 쉬움: 0, 보통: 0, 어려움: 0 }
for (const 난 of 난이도들) {
  console.log(`\n=== ${난} (★${난이도표[난].별}) · 벌이 ×${난이도표[난].벌이} · 성 ×${난이도표[난].내성}`)
  console.log('스테이지'.padEnd(18) + 이름들.map((n) => n.padStart(10)).join(''))
  판목록[난].forEach((s, idx) => {
    const 쓸것 = 판덱(idx)
    const 줄: string[] = []
    let 이판깼나 = false
    for (const n of 이름들) {
      const 번 = n === '막누름' ? 판수 : 1
      let 이김 = 0
      for (let i = 1; i <= 번; i++) if (한판(s, 작전들[n], i * 7919, 쓸것).이김) 이김++
      표[난][n] = (표[난][n] ?? 0) + 이김 / 번
      if ((n === '다내기' || n === '아껴서') && 이김) 이판깼나 = true
      줄.push((번 === 1 ? (이김 ? '승' : '패') : `${이김}/${번}`).padStart(10))
    }
    if (이판깼나) 깰수있나[난]++
    console.log(s.이름.replace(/^\d+\. /, '').padEnd(18) + 줄.join(''))
  })
  console.log('합계'.padEnd(18) + 이름들.map((n) => (표[난][n].toFixed(1) + '/12').padStart(10)).join(''))
  console.log(`  → 어느 방법으로든 깰 수 있는 판: ${깰수있나[난]}/12`)
}

// ── 판정 ────────────────────────────────────────────────────────────────────
console.log('\n판정:')
const 문제: string[] = []
for (const 난 of 난이도들) {
  const R = 표[난]
  const 여기: string[] = []
  if (R['벽만'] > 0) 여기.push(`벽만 세워도 이긴다(${R['벽만'].toFixed(1)}/12)`)
  // ⚠️ **두 작전 중 나은 쪽으로 본다.** 돈이 넉넉한 쉬움에서는 「다 내기」가, 빠듯한 어려움에서는
  //    「아껴서」가 낫다 — 한쪽만 보면 멀쩡한 난이도를 고장이라 신고한다(2026-08-17에 겪음).
  const 최선 = 깰수있나[난]
  if (최선 < 12) 여기.push(`어느 작전으로도 못 깨는 판이 ${12 - 최선}개 있다`)
  if (난 === '어려움' && R['다내기'] > 10.5) 여기.push(`막 다 내도 거의 다 깬다(${R['다내기'].toFixed(1)}/12) — 어렵지 않다`)
  if (난 === '쉬움' && R['다내기'] < 12) 여기.push(`쉬움인데 다 내도 못 깨는 판이 있다(${R['다내기'].toFixed(1)}/12)`)
  if (여기.length) { 문제.push(난); console.log('  ✗ ' + 난); for (const m of 여기) console.log('      ' + m) }
  else console.log('  ✓ ' + 난)
}
// 난이도가 올라갈수록 어려워지나
const 막 = 난이도들.map((d) => 표[d]['막누름'])
if (!(막[0] > 막[1] && 막[1] > 막[2])) {
  문제.push('차례')
  console.log(`  ✗ 난이도 차례가 안 맞는다 — 막누름 쉬움 ${막[0].toFixed(1)} · 보통 ${막[1].toFixed(1)} · 어려움 ${막[2].toFixed(1)}`)
} else console.log('  ✓ 난이도가 올라갈수록 어려워진다')
console.log(문제.length ? `\n${문제.length}가지 손봐야 합니다.` : '\n난이도 셋 다 잣대를 지납니다.')
